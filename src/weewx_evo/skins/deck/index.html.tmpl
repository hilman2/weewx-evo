#errorCatcher Echo
#encoding UTF-8
#attr $context = 'day'
#attr $daily_archive = False
#attr $use_parameter_month = False
#attr $use_parameter_year = False

<!DOCTYPE html>
<html lang="$lang">
  <head>
    #include "includes/html-head.inc"
    <title>$station.location - $gettext("Current Weather Conditions")</title>
    #if 'refresh_interval' in $Extras
    <meta http-equiv="refresh" content="$Extras.refresh_interval" />
    #end if
  </head>

  <body class="theme-$DisplayOptions.get('layout', 'alternative')">
    #include "includes/ui-shell.inc"

    <main class="main" id="main">
      <div class="wrap">
<header class="page-head">
              <h1>$gettext("Current Weather Conditions")</h1>
              <h2>$current.dateTime</h2>
            </header>

          #if $DisplayOptions.get('layout', 'alternative') == 'alternative'
            #include 'includes/body-alternative.inc'
          #else
            #include 'includes/body-classic.inc'
          #end if
<!--Stat tile Modals-->
    #if $DisplayOptions.get('layout', 'alternative') == 'alternative'
      #include "includes/stat-tile-modals.inc"
    #end if

    <!--Externals Modals-->
    #set $externals_list = []
    #if 'externals' in $Extras and $len($Extras['externals']) > 0
      #for $external in $Extras['externals']
        #if $external == 'description'
          #continue
        #end if
        #if $to_bool($Extras['externals'][$external].show_on_front)
          #silent $externals_list.append($external)
        #end if
      #end for
    #end if

    #if ('radar_html' in $Extras or $len($externals_list) > 0) and 'open_radar_and_externals_modal' in $Extras and $to_bool($Extras['open_radar_and_externals_modal'])
      #if 'radar_html' in $Extras
        <dialog id="modal-radar-default" size="md" fullWidth>
          <div class="card__head">
            <button type="button" class="icon-button" data-dialog-close aria-label="Close" style="margin-inline-start:auto"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M24 9.4 22.6 8 16 14.6 9.4 8 8 9.4l6.6 6.6L8 22.6 9.4 24l6.6-6.6 6.6 6.6 1.4-1.4-6.6-6.6z"/></svg></button>
            <!-- <span class="muted">Label (Optional)</span> -->
            <h3>$gettext("Recent radar")</h3>
          </div>
          <div class="card__body">
            $Extras.radar_html
          </div>
        </dialog>

        <script type="text/javascript">
          document
            .getElementById("panel-radar")
            .addEventListener("click", () => {
              document.getElementById("modal-radar-default").open = true;
            });

          if (document .querySelector("#panel-radar a")) {
            document
              .querySelector("#panel-radar a")
              .addEventListener("click", (event) => {
                event.preventDefault();
              });
          }
        </script>
        <style>
          #panel-radar {
            cursor: pointer;
          }
        </style>
      #end if

      #for $external in externals_list
        <dialog id="modal-$external" size="md" fullWidth>
          <div class="card__head">
            <button type="button" class="icon-button" data-dialog-close aria-label="Close" style="margin-inline-start:auto"><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M24 9.4 22.6 8 16 14.6 9.4 8 8 9.4l6.6 6.6L8 22.6 9.4 24l6.6-6.6 6.6 6.6 1.4-1.4-6.6-6.6z"/></svg></button>
            <span class="muted">$Extras['externals'][$external].title_long</span>
            <h3>$Extras['externals'][$external].title</h3>
          </div>
          <div class="card__body">
            $Extras['externals'][$external].source
          </div>
        </dialog>

        <script type="text/javascript">
          document
            .getElementById("panel-$external")
            .addEventListener("click", () => {
              document.getElementById("modal-$external").open = true;
            });

          if (document .querySelector("#panel-$external a")) {
            document
              .querySelector("#panel-$external a")
              .addEventListener("click", (event) => {
                event.preventDefault();
              });
          }
        </script>
        <style>
          #panel-$external {
            cursor: pointer;
          }
        </style>
      #end for
    #end if

    #include "includes/footer.inc"


## Live readings. The station POSTs them to live.php, which writes them
## beside itself; this reads that file. Nothing is opened anywhere for it --
## same web server as the page, same https, same origin.
#if $to_bool($Extras.get('live_push', 1))
    <script>
      window.deckLivePoll = {
        url: "$Extras.get('live_push_file', 'live.json')",
        every: $Extras.get('live_push_every', 15)
      };
      window.deckLiveStrings = {
        live: "$gettext('LIVE')",
        stale: "$gettext('LIVE')",
        offline: "$gettext('OFFLINE')",
        waiting: "…",
        connecting: "$gettext('connecting')",
        justNow: "$gettext('just now')",
        secondsAgo: "$gettext('s ago')",
        minutesAgo: "$gettext('min ago')",
        hoursAgo: "$gettext('h ago')",
        daysAgo: "$gettext('d ago')",
        liveSince: "$gettext('Updated')",
        lastSeen: "$gettext('Last live reading')",
        noBroker: "$gettext('No connection to the live feed.')",
        waitingFor: "$gettext('Waiting for the first reading.')",
        neverSent: "$gettext('The station does not publish this reading live.')"
      };
    </script>
    <script src="$get_base_path(path='assets/live-poll.js')" defer></script>
    <script src="$get_base_path(path='assets/live-status.js')" defer></script>
    #end if
  </body>
</html>
