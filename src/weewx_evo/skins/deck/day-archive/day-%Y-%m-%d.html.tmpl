<!--prettier-ignore-->
#errorCatcher Echo
#encoding UTF-8
#import datetime
#attr $context = 'day'
#attr $daily_archive = True
#attr $use_parameter_month = False
#attr $use_parameter_year = False

<!DOCTYPE html>
<html lang="$lang">
  <head>
    #include "includes/html-head.inc"
    <title>$station.location - $gettext("Archive")</title>
  </head>

  <body class="theme-$DisplayOptions.get('layout', 'alternative')">
    #include "includes/ui-shell.inc"

    <main class="main">
      <section>
        <div>
          <div>
            <header class="page-header">
              <h1>$gettext("Archive")</h1>
              <h2>
                $spell($day.dateTime, $get_time_format_dict['daily_archive'])
              </h2>
            </header>
          </div>

          <!--prettier-ignore-->
          #if $get_day_archive_enabled()
          <!--prettier-ignore-->
          <div style="margin-bottom: 2rem;">
            <div>
              #set $archive_days = $get_archive_days_array($alltime.dateTime.raw, $latest.dateTime.raw, $get_time_format_dict['daily_archive'])
              <script>
                var archive_days = $jsonize($archive_days);
                var archive_date_time = {
                  format: "$get_time_format_dict['daily_archive']",
                  now: "$spell($latest.dateTime, $get_time_format_dict['daily_archive'])",
                }
              </script>
              <div class="statistics-day-select"></div>
            </div>
          </div>
          #end if

          <!--prettier-ignore-->
          #if $DisplayOptions.get('layout', 'alternative') == 'alternative'
            #include 'includes/body-alternative.inc'
          #else
            #include 'includes/body-classic.inc'
          #end if
        </div>
      </section>
    </main>

    <!--Stat tile Modals-->
    #if $DisplayOptions.get('layout', 'alternative') == 'alternative'
      #include "includes/stat-tile-modals.inc"
    #end if

    #include "includes/footer.inc"

</body>
</html>
