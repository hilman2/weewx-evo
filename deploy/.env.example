# Copy to .env beside this file. It is in .gitignore, and it is the only
# place a secret belongs.
#
#   cp .env.example .env
#   python -c "import secrets; print(secrets.token_urlsafe(24))"   # for each

# The token hardware puts in the upload path. It is the only thing between the
# open internet and the measurement series. Consoles cannot send headers, so it
# travels in the URL and is therefore guessable: the listener answers a wrong
# one with 404 and allows five wrong ones a minute.
WEEWX_EVO_TOKEN=

# The settings page has its own, and refuses to start if the two are the same.
# An upload can at worst write a wrong reading; this can point the archive at a
# different file.
WEEWX_EVO_ADMIN_TOKEN=

# Where the databases and the configuration live on the host.
#WEEWX_EVO_DATA=/opt/weewx-evo/data

# The station's own timezone. The archive day boundary is local midnight, so
# this is part of the data.
#TZ=Europe/Berlin

# Seconds between archive records.
#WEEWX_EVO_INTERVAL=300

# What `weewx-evo url` prints. Behind a reverse proxy the container cannot
# work the outside address out for itself.
#WEEWX_EVO_PUBLIC_URL=https://weather.example.org

# Ports on the loopback interface, for a reverse proxy to point at.
#WEEWX_EVO_PORT=3041
#WEEWX_EVO_ADMIN_PORT=3042
# The pages the exports published, for a reverse proxy to point at.
#WEEWX_EVO_WEB_PORT=3043

# journald on a systemd host, json-file elsewhere.
#WEEWX_EVO_LOG_DRIVER=json-file
